<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Intentionally minimal for sideload compatibility.
         - No app group: Loupe has no extension; it stores in its own sandbox.
         - No multicast: the gadget channel is loopback TCP (needs only the
           NSLocalNetworkUsageDescription in Info.plist, not an entitlement).
         Add capabilities here only once they're provisioned in your signing profile. -->
</dict>
</plist>
